<h1>Neue Buchung</h1>
<form method="post">
    <div class="mb-3">
        <label for="createArticle" class="form-label">Artikel</label>
        <select name="createArticle" id="createArticle" class="form-select" required>
            <option value="" selected disabled>--- Artikel wählen ---</option>
            <% for(const article of articles) {%>
                <option value="<%=article.Id%>"><%=article.ArticleNumber%> - <%=article.Name%></option>
            <%}%>
        </select>
    </div>
    <div class="mb-3">
        <label for="createType" class="form-label">Buchungsart</label>
        <select name="createType" id="createType" class="form-select" required>
            <option value="" selected disabled>--- Buchungsart wählen ---</option>
            <option value="1">Zugang (Wareneingang)</option>
            <option value="0">Abgang (Warenausgang)</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="createQuantity" class="form-label">Menge</label>
        <input class="form-control" type="number" step="1" min="0" name="createQuantity" id="createQuantity" required>
    </div>
    <div class="mb-3">
        <label for="createPrice" class="form-label">Preis (Einkaufspreis)</label>
        <input class="form-control" type="number" step="0.01" min="0" name="createPrice" id="createPrice" required>
    </div>
    <div class="mb-3">
        <label for="createDate" class="form-label">Datum</label>
        <input class="form-control" type="date" name="createDate" id="createDate" value="<%= new Date().toISOString().slice(0,10) %>">
    </div>
    <div class="mb-3">
        <label for="createDescription" class="form-label">Beschreibung</label>
        <input class="form-control" type="text" name="createDescription" id="createDescription">
    </div>
    <button class="btn btn-primary" type="submit">Anlegen</button>
</form>
