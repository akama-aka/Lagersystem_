<h1>Buchung bearbeiten</h1>
<form method="post">
    <div class="mb-3">
        <label for="createArticle" class="form-label">Artikel</label>
        <select name="createArticle" id="createArticle" class="form-select" required>
            <option selected disabled>--- Artikel wählen ---</option>
            <% for(const article of articles) {%>
                <option value="<%=article.Id%>" <%= (transaction.article && transaction.article.Id == article.Id) ? 'selected' : '' %>><%=article.ArticleNumber%> - <%=article.Name%></option>
            <%}%>
        </select>
    </div>
    <div class="mb-3">
        <label for="createType" class="form-label">Buchungsart</label>
        <select name="createType" id="createType" class="form-select" required>
            <option value="1" <%= transaction.Type ? 'selected' : '' %>>Zugang (Wareneingang)</option>
            <option value="0" <%= !transaction.Type ? 'selected' : '' %>>Abgang (Warenausgang)</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="createQuantity" class="form-label">Menge</label>
        <input class="form-control" type="number" step="1" min="0" name="createQuantity" id="createQuantity" value="<%=transaction.Quantity%>" required>
    </div>
    <div class="mb-3">
        <label for="createPrice" class="form-label">Preis (Einkaufspreis)</label>
        <input class="form-control" type="number" step="0.01" min="0" name="createPrice" id="createPrice" value="<%=transaction.Price%>" required>
    </div>
    <div class="mb-3">
        <label for="createDate" class="form-label">Datum</label>
        <input class="form-control" type="date" name="createDate" id="createDate" value="<%= transaction.createdAt.toISOString().slice(0,10) %>">
    </div>
    <div class="mb-3">
        <label for="createDescription" class="form-label">Beschreibung</label>
        <input class="form-control" type="text" name="createDescription" id="createDescription" value="<%=transaction.Description%>">
    </div>
    <button class="btn btn-primary" type="submit">Speichern</button>
</form>
