<h1>Buchung ansehen</h1>
<p><b>Artikel: </b><%=transaction.article ? (transaction.article.ArticleNumber + " - " + transaction.article.Name) : "-"%></p>
<p><b>Typ: </b><%=transaction.Type ? "Zugang" : "Abgang"%></p>
<p><b>Menge: </b><%=transaction.Quantity%></p>
<p><b>Preis: </b><%=transaction.Price%></p>
<p><b>Beschreibung: </b><%=transaction.Description%></p>
<p><b>Datum: </b><%=transaction.createdAt%></p>

<button class="btn btn-primary" onclick="location.href='/<%=transaction.Id%>/edit'">Bearbeiten</button>
<button class="btn btn-danger" onclick="location.href='/<%=transaction.Id%>/delete'">Löschen</button>
