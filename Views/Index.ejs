<h1>Buchungen</h1>
<p class="text-muted">Übersicht aller Zu- und Abbuchungen. Jede Buchung kann jederzeit im Nachhinein über das Auge-Symbol eingesehen werden.</p>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <% if(orderBy == "Quantity") {
                if(orderDir == "asc") {%>
                    <th scope="col">Menge <button class="btn btn-primary btn-sm" onclick="location.href='/?orderBy=Quantity&orderDir=desc'"><i class="fa-solid fa-sort-down"></i></button></th>
                <%} else {%>
                    <th scope="col">Menge <button class="btn btn-primary btn-sm" onclick="location.href='/?orderBy=Quantity&orderDir=asc'"><i class="fa-solid fa-sort-up"></i></button></th>
                <%}
            } else {%>
                <th scope="col">Menge <button class="btn btn-primary btn-sm" onclick="location.href='/?orderBy=Quantity&orderDir=desc'"><i class="fa-solid fa-sort-down"></i></button></th>
            <%}%>
            <th scope="col">Preis</th>
            <th scope="col">Beschreibung</th>
            <th scope="col">Artikel</th>
            <th scope="col">Typ</th>
            <%if(orderBy == "createdAt" && orderDir == "asc") {%>
                <th scope="col">Datum <button class="btn btn-primary btn-sm" onclick="location.href='/?orderBy=createdAt&orderDir=desc'"><i class="fa-solid fa-sort-down"></i></button></th>
            <%} else {%>
                <th scope="col">Datum <button class="btn btn-primary btn-sm" onclick="location.href='/?orderBy=createdAt&orderDir=asc'"><i class="fa-solid fa-sort-up"></i></button></th>
            <%}%>
            <th scope="col"><button class="btn btn-primary" onclick="location.href='/new'"><i class="fa-solid fa-plus"></i></button></th>
        </tr>
    </thead>
    <tbody>
        <% for (const transaction of transactions) { %>
            <tr>
                <th scope="row"><%= transaction.Id %></th>
                <td><%=transaction.Quantity%></td>
                <td><%=transaction.Price%></td>
                <td><%=transaction.Description%></td>
                <td><%=transaction.article ? transaction.article.Name : "-"%></td>
                <td><span class="badge <%=transaction.Type ? 'bg-success' : 'bg-danger'%>"><%=transaction.Type ? "Zugang" : "Abgang"%></span></td>
                <td><%=transaction.createdAt%></td>
                <td><button class="btn btn-primary" onclick="location.href='/<%=transaction.Id%>'"><i class="fa-solid fa-eye"></i></button></td>
            </tr>
        <% } %>
    </tbody>
</table>
