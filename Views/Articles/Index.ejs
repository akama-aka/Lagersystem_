<h1>Artikel</h1>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Artikelnummer</th>
            <th scope="col">Name</th>
            <th scope="col">Beschreibung</th>
            <th scope="col"><button class="btn btn-primary" onclick="location.href='/articles/new'"><i class="fa-solid fa-plus"></i></button></th>
        </tr>
    </thead>
    <tbody>
        <% for(const article of articles) { %>
            <tr>
                <th scope="row"><%= article.Id %></th>
                <td><%=article.ArticleNumber%></td>
                <td><%=article.Name%></td>
                <td><%=article.Description%></td>
                <td><button class="btn btn-primary" onclick="location.href='/articles/<%=article.Id%>'"><i class="fa-solid fa-eye"></i></button></td>
            </tr>
        <%}%>
    </tbody>
</table>
