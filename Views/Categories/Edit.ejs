<h1>Editing a Transaction</h1>
<form method="post">
    <div class="mb-3">
        <label for="createName" class="form-label">Name</label>
        <input class="form-control" type="text" name="createName" id="createName" value="<%=category.Name%>">
    </div>
    <div class="mb-3">
        <label for="categoryColour" class="form-label">Colour</label>
        <input class="form-control" type="color" name="categoryColour" id="categoryColour" value="<%=category.Colour%>">
    </div>
    <button class="btn btn-primary" type="submit">Edit</button>
</form>