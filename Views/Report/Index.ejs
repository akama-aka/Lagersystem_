<h1>Lagerbericht</h1>
<p class="text-muted">Erstellt am <%=generatedAt.toLocaleString('de-DE')%></p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Artikelnummer</th>
            <th>Artikelname</th>
            <th>Menge</th>
            <th>Gesamtwert</th>
        </tr>
    </thead>
    <tbody>
        <% for(const item of stock) { %>
            <tr>
                <td><%=item.ArticleNumber%></td>
                <td><%=item.Name%></td>
                <td><%=item.Quantity%></td>
                <td><%=item.TotalValue.toFixed(2)%></td>
            </tr>
        <% } %>
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Gesamtwert des Lagers</th>
            <th><%= stock.reduce((sum,item) => sum + item.TotalValue, 0).toFixed(2) %></th>
        </tr>
    </tfoot>
</table>
<button class="btn btn-primary" onclick="window.print()">Drucken</button>
